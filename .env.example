# ====================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE: Syariah Digital Check
# ====================================================================
# PETUNJUK KEAMANAN (SECURITY INSTRUCTIONS):
# 1. Salin berkas ini ke '.env.local' untuk pengembangan lokal.
# 2. DILARANG KERAS menyimpan atau meng-commit kunci rahasia (service_role) ke repositori publik!
# 3. Kunci anonim (ANON KEY) aman digunakan di sisi client (browser / React Native).
# 4. Jika SUPABASE_URL atau ANON_KEY tidak diatur, aplikasi otomatis beroperasi 100% dalam
#    MODE TAMU LOKAL (Guest-First LocalStorage Mode) tanpa error atau penurunan fitur edukasi.
# ====================================================================

# --- Public Client Configuration (Web & Mobile) ---
# URL instans Supabase Anda (misal: https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci publik anonim Supabase (Anon Key yang mematuhi batasan RLS)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Server / CI/CD Only Configuration (NEVER EXPOSE TO BROWSER / CLIENT BUILD) ---
# Kunci service_role HANYA untuk pipeline migrasi database CLI atau script admin di backend privat.
# SUPABASE_SERVICE_ROLE_KEY=ey...

# Konfigurasi Port Lokal Web Server
PORT=8088
